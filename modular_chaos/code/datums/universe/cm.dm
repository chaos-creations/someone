/// The Colonial Marines universe of upstream, the one the server runs in by default
/datum/universe/cm
	id = UNIVERSE_CM
	name = "Colonial Marines"
	races = list(RACE_HUMAN, RACE_SYNTHETIC)
	default_race = RACE_HUMAN
	origins = list(
		ORIGIN_MERCURY, ORIGIN_VENUS, ORIGIN_EARTH, ORIGIN_LUNA, ORIGIN_MARS, ORIGIN_JUPITER, ORIGIN_SATURN, ORIGIN_URANUS, ORIGIN_NEPTUNE,
	)
	default_origin = ORIGIN_EARTH
