// Colours of Baystation 12 (code/__defines/colors.dm in the source) that paint its walls, low walls and airlocks.
// COLOR_WHITE, COLOR_RED, COLOR_ORANGE and COLOR_CYAN are upstream's, with the same values.

// Materials: the colour an unpainted wall or low wall takes from what it is made of
#define COLOR_STEEL "#a8b0b2"
/// Not a define in the source: the icon_colour of /material/plasteel, the reinforcement of reinforced walls
#define COLOR_PLASTEEL "#a8a9b2"
/// Not a define in the source: the icon_colour of /material/plasteel/titanium
#define COLOR_TITANIUM "#d1e6e3"
